{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "SqlitePath": "data/mymusic.db"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "storage",
    "S3Region": "auto",
    "S3ForcePathStyle": true
  },
  "Upload": {
    "MaxAudioMb": 60,
    "MaxCoverMb": 5
  },
  "Auth": {
    "AllowRegistration": true
  }
}
